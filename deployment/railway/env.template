# ═══════════════════════════════════════════════════════════════════════════════
# Railway Environment Variables Template
# ═══════════════════════════════════════════════════════════════════════════════
# SECURITY: Never commit real secrets. Copy values into Railway Dashboard only.
# Railway → Project → Service → Variables → Raw Editor
#
# Generate secrets:
#   node deployment/railway/scripts/generate-secrets.mjs
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV=production
SERVE_STATIC=true

# Railway injects PORT automatically — do not hardcode in production
# PORT=
REG_SERVER_PORT=4001

# Public URL (your Railway domain or custom domain)
NEXT_PUBLIC_SITE_URL=https://your-app.up.railway.app

# Optional: comma-separated CORS origins
# CORS_ORIGINS=https://your-app.up.railway.app

# ─── Database (PostgreSQL) ─────────────────────────────────────────────────────
# Add PostgreSQL plugin in Railway, then reference variables:
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# DIRECT_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/railway?schema=public&sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST:PORT/railway?schema=public&sslmode=require

# ─── Auth Secrets (min 32 chars each) ────────────────────────────────────────
NEXTAUTH_SECRET=GENERATE_UNIQUE_SECRET_MIN_32_CHARS
JWT_ACCESS_SECRET=GENERATE_UNIQUE_SECRET_MIN_32_CHARS
JWT_REFRESH_SECRET=GENERATE_UNIQUE_SECRET_MIN_32_CHARS
JWT_ISSUER=capital-network-api
JWT_AUDIENCE=capital-network-web

# ─── Admin Seed (first deploy only) ───────────────────────────────────────────
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=GENERATE_STRONG_PASSWORD_MIN_8_CHARS
ADMIN_PASSWORD_SALT=GENERATE_UNIQUE_SALT_MIN_32_CHARS

# ─── Optional: Supabase ──────────────────────────────────────────────────────
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Optional: Firebase ──────────────────────────────────────────────────────
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# ─── Optional: First-deploy seed ───────────────────────────────────────────────
# Set RUN_SEED=true only on first deployment, then remove
# RUN_SEED=true

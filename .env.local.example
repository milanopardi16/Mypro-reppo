# Local overrides — copy to .env.local (gitignored)
# Loaded after .env by server and Prisma CLI.

# Override database for local/staging
# DATABASE_URL=postgresql://user:password@host:5432/db?sslmode=require

# Supabase client (Vite exposes NEXT_PUBLIC_* at build time)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase server-only (never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional local admin overrides for seed
# ADMIN_EMAIL=admin@capitalnetwork.local
# ADMIN_PASSWORD=change-me-strong-password-min-8-chars

# Optional JWT overrides for local dev
# JWT_ACCESS_SECRET=local-dev-access-secret-minimum-32-chars
# JWT_REFRESH_SECRET=local-dev-refresh-secret-minimum-32-chars

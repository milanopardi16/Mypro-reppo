# Capital Network — Secure Environment Variables Template
# SECURITY WARNING: Never commit real secrets to version control.
# Copy this file to .env and .env.local, then replace placeholders with real values.
#
# ═════════════════════════════════════════════════════════════════════════════════════
# DEPLOYMENT INSTRUCTIONS:
# ═════════════════════════════════════════════════════════════════════════════════════
#
# 1. For LOCAL DEVELOPMENT:
#    - Copy this file to .env.local
#    - Use environment-specific values
#    - Never commit .env or .env.local
#
# 2. For RAILWAY DEPLOYMENT:
#    - Set all variables in Railway dashboard (Project → Variables)
#    - Use cryptographically secure secrets
#    - See railway-env-template.txt for Railway-specific guidance
#    - See DEPLOYMENT_ENVIRONMENT.md for complete documentation
#
# 3. SECURITY BEST PRACTICES:
#    - Rotate secrets regularly (especially before production launch)
#    - Use different secrets for dev, staging, and production
#    - Ensure all required secrets are set before deployment
#    - Monitor secret access and expiration
#
# ═════════════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────────────
# RUNTIME ENVIRONMENT
# ─────────────────────────────────────────────────────────────────────────────────────
# Specifies the runtime environment. Set to 'production' for Railway deployment.
NODE_ENV=development

# Server port for Express/Vite API server (default: 4001)
PORT=4001
REG_SERVER_PORT=4001

# Public site URL used for CORS, cookies, and redirects
# Must be accessible from the browser (not localhost in production)
NEXT_PUBLIC_SITE_URL=http://localhost:5173

# ─────────────────────────────────────────────────────────────────────────────────────
# DATABASE CONFIGURATION (PostgreSQL via Prisma)
# ─────────────────────────────────────────────────────────────────────────────────────
# Standard Prisma connection URL (with connection pooling if using PgBouncer)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public

# Direct database connection URL (for migrations; bypasses connection pooling)
# Required for Prisma migrations. If using PgBouncer, set to native PostgreSQL connection.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DIRECT_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public

# ─────────────────────────────────────────────────────────────────────────────────────
# AUTHENTICATION & SECURITY (JWT)
# ─────────────────────────────────────────────────────────────────────────────────────
# NextAuth.js secret (minimum 32 characters, cryptographically random)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=GENERATE_AT_DEPLOY_TIME_MIN_32_CHARS

# JWT Access Token Secret (minimum 32 characters, cryptographically random)
# Used to sign JWT access tokens for admin authentication.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# CRITICAL: Must be at least 32 characters for production security.
JWT_ACCESS_SECRET=GENERATE_AT_DEPLOY_TIME_MIN_32_CHARS

# JWT Refresh Token Secret (minimum 32 characters, cryptographically random)
# Used to sign JWT refresh tokens for long-lived authentication.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# CRITICAL: Must be at least 32 characters for production security.
JWT_REFRESH_SECRET=GENERATE_AT_DEPLOY_TIME_MIN_32_CHARS

# JWT Token Issuer (optional, used in JWT claims)
# Identifies the entity that issued the token (e.g., your API name)
# Default: capital-network-api
JWT_ISSUER=capital-network-api

# JWT Token Audience (optional, used in JWT claims)
# Identifies the intended recipient of the token (e.g., your frontend domain)
# Default: capital-network-web
JWT_AUDIENCE=capital-network-web

# ─────────────────────────────────────────────────────────────────────────────────────
# ADMIN ACCOUNT (Used by Prisma seed during deployment)
# ─────────────────────────────────────────────────────────────────────────────────────
# CRITICAL: These are ONLY used during `prisma db seed` to create the first admin account.
# After deployment, change the password via the admin panel.
# Do NOT use the same password across environments.

# Admin email address (used for login and account recovery)
ADMIN_EMAIL=admin@example.com

# Admin username (fallback if email-based login is not used)
# Can be overridden to use email as username.
ADMIN_USERNAME=admin

# Admin initial password (minimum 8 characters)
# CRITICAL: Must be changed immediately after first login in production.
# DO NOT reuse passwords across environments.
# Generate secure password: openssl rand -base64 12
ADMIN_PASSWORD=CHANGE_ME_BEFORE_PRODUCTION_MIN_8_CHARS

# Admin password salt (minimum 32 characters, cryptographically random)
# Used for password hashing security. Must NOT be committed.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ADMIN_PASSWORD_SALT=GENERATE_AT_DEPLOY_TIME_MIN_32_CHARS

# ─────────────────────────────────────────────────────────────────────────────────────
# LEGACY & OPTIONAL CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────────────
# Legacy Socket.IO admin handshake token (DISABLE in production if unused)
# If set, allows admin authentication via socket.io during development only.
# DO NOT use in production without explicit security review.
# ADMIN_TOKEN=

# API URL override (optional, defaults to REG_SERVER_PORT)
# Useful for local verification scripts and external API testing.
# Example: https://api.yourdomain.com
# API_URL=

# CORS allowed origins (comma-separated)
# If not set, defaults to NEXT_PUBLIC_SITE_URL
# Example: https://domain1.com,https://domain2.com
# CORS_ORIGINS=

# Static file serving (defaults to true in production)
# Set to true to serve Vite build from Express in production environments.
# SERVE_STATIC=true

# ─────────────────────────────────────────────────────────────────────────────────────
# FIREBASE CLOUD MESSAGING (Optional)
# ─────────────────────────────────────────────────────────────────────────────────────
# Only required if using Firebase for push notifications.
# Leave empty/commented if not using Firebase.
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# ─────────────────────────────────────────────────────────────────────────────────────
# SUPABASE (Optional)
# ─────────────────────────────────────────────────────────────────────────────────────
# Client-side keys (exposed via NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only key (never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

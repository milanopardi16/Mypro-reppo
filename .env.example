# Capital Network — shared environment template
# Copy to .env and .env.local.example, then fill in values.
# Never commit .env or .env.local with real secrets.

NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:5173

# PostgreSQL (required)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/capital_network?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/capital_network?schema=public

# NextAuth secret (required)
NEXTAUTH_SECRET=change-me-nextauth-secret-minimum-32-characters-long

# API server port (default 4001)
REG_SERVER_PORT=4001

# Admin account — used by prisma db seed for first admin (REQUIRED in production)
ADMIN_EMAIL=admin@capitalnetwork.local
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password-minimum-8-chars
ADMIN_PASSWORD_SALT=your-random-salt-minimum-32-characters-long

# JWT (required, min 32 characters each)
JWT_ACCESS_SECRET=change-me-access-secret-minimum-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-minimum-32-characters-long

# JWT issuer and audience (optional, defaults provided)
JWT_ISSUER=capital-network-api
JWT_AUDIENCE=capital-network-web

# Optional: legacy Socket.IO admin handshake token (disable in production if unused)
# ADMIN_TOKEN=

# Serve Vite build from Express in production
# SERVE_STATIC=true

# Production CORS allowlist (comma-separated origins). Falls back to NEXT_PUBLIC_SITE_URL.
# CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Firebase Cloud Messaging (optional)
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# Supabase client values (optional)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase server-only (never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

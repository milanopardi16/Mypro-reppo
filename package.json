{
  "name": "my-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"node ./node_modules/vite/bin/vite.js\"",
    "dev:4002": "cross-env REG_SERVER_PORT=4002 concurrently \"npm run dev:api\" \"node ./node_modules/vite/bin/vite.js\"",
    "dev:api": "node server/api-server.js",
    "build": "node ./node_modules/vite/bin/vite.js build",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "start": "node server/api-server.js",
    "start:prod": "cross-env NODE_ENV=production node server/api-server.js",
    "lint": "eslint",
    "validate": "npm run validate:env && npm run validate:prisma && npm run validate:migrations && npm run db:validate-seed && npm run lint && npm run build",
    "validate:env": "node scripts/validate-env.mjs",
    "validate:prisma": "prisma validate",
    "validate:migrations": "node scripts/validate-migrations.mjs",
    "validate:build": "npm run build",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:setup": "prisma migrate deploy && prisma db seed",
    "db:validate-seed": "node scripts/validate-seed-schema.mjs",
    "postinstall": "prisma generate"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "@supabase/supabase-js": "2.105.4",
    "@uiw/react-md-editor": "^4.1.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "firebase-admin": "^13.10.0",
    "framer-motion": "^12.38.0",
    "helmet": "^8.2.0",
    "html2canvas": "^1.4.1",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "multer": "^1.4.5-lts.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-router-dom": "^7.6.2",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@vitejs/plugin-react": "^5.1.0",
    "babel-plugin-react-compiler": "1.0.0",
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "prisma": "^6.19.0",
    "vite": "^7.1.10"
  }
}

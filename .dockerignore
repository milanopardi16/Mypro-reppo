# Git and source control
.git
.gitignore
.gitattributes

# Node.js and package managers
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.npmrc
.yarn.lock
yarn.lock

# Environment files (secrets should never be in Docker image)
.env
.env.local
.env.*.local
.env.production
.env.staging
.env.development

# Build outputs (regenerated in Docker)
dist/
build/
.next/
out/
coverage/
.nyc_output/

# Runtime data and user uploads (not baked into image)
/uploads/*
!uploads/.gitkeep
public/uploads/*
!public/uploads/.gitkeep
data/
logs/
*.log

# Testing
.mocha
coverage

# IDE and editor files
.vscode/
.idea/
*.sublime-workspace
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# CI/CD
.github/
.gitlab-ci.yml
azure-pipelines.yml
.travis.yml

# Documentation (not needed in production image)
docs/
deployment/
railway-deployment/
*.md

# Cache and temporary files
.cache/
.tmp/
/tmp
*.tmp

# Security files (never include in image)
*.pem
*.key
*.cert
*.crt
.ssh/

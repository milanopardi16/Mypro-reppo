# Production environment example for Railway
NODE_ENV=production
PORT=4001
REG_SERVER_PORT=4001
DATABASE_URL=postgresql://user:password@host:5432/dbname?schema=public
DIRECT_URL=https://your-production-domain.example
NEXTAUTH_SECRET=replace-with-strong-secret
JWT_ACCESS_SECRET=replace-with-strong-secret-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-strong-secret-at-least-32-chars
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
ADMIN_PASSWORD_SALT=replace-with-salt-string
CORS_ORIGINS=https://your-production-domain.example
NEXT_PUBLIC_SITE_URL=https://your-production-domain.example
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
ADMIN_TOKEN=
SERVE_STATIC=true

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  admins      Admin[]
  users       User[]

  @@map("roles")
}

model User {
  id            String         @id
  email         String?
  authEmail     String?        @unique @map("auth_email")
  fullName      String?        @map("full_name")
  phone         String?
  companyName   String?        @map("company_name")
  position      String?
  industry      String?
  website       String?
  message       String?
  passwordHash  String?        @map("password_hash")
  roleId        String?        @map("role_id")
  role          Role?          @relation(fields: [roleId], references: [id])
  createdAt     DateTime       @default(now()) @map("created_at")
  notifications Notification[]
  chatRooms     ChatRoom[]
  pushTokens    PushToken[]

  @@index([email])
  @@map("users")
}

model Admin {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String         @map("password_hash")
  name          String         @default("Admin")
  roleId        String         @map("role_id")
  role          Role           @relation(fields: [roleId], references: [id])
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  chatRooms     ChatRoom[]
  pushTokens    PushToken[]

  @@map("admins")
}

model RefreshToken {
  id        String    @id @default(cuid())
  token     String    @unique
  adminId   String    @map("admin_id")
  admin     Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([adminId])
  @@map("refresh_tokens")
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String   @default("")
  type      String   @default("system")
  userId    String?  @map("user_id")
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  actorRef  String?  @map("actor_ref")
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([isRead, createdAt])
  @@index([userId])
  @@map("notifications")
}

model BlogPost {
  id         String   @id @default(cuid())
  slug       String?
  title      String
  excerpt    String   @default("")
  content    String   @default("")
  coverImage String?  @map("cover_image")
  tags       String[] @default([])
  category   String?
  status     String   @default("draft")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("blog_posts")
}

model Assessment {
  id              String   @id
  profileType     String?  @map("profile_type")
  fullName        String?  @map("full_name")
  email           String?
  phone           String?
  linkedin        String?
  companyName     String?  @map("company_name")
  sector          String?
  stage           String?
  capitalRequired String?  @map("capital_required")
  oneLiner        String?  @map("one_liner")
  orgName         String?  @map("org_name")
  ticketSize      String?  @map("ticket_size")
  stagePref       String?  @map("stage_pref")
  geoPref         String?  @map("geo_pref")
  confidence      String?
  message         String?
  confirmAccuracy Boolean  @default(false) @map("confirm_accuracy")
  deckFile        String?  @map("deck_file")
  reviewed        Boolean  @default(false)
  notes           String   @default("")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([reviewed, createdAt])
  @@map("assessments")
}

model ContactMessage {
  id        String   @id
  fullName  String   @map("full_name")
  email     String?
  subject   String?
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([read, createdAt])
  @@map("contact_messages")
}

model ChatRoom {
  id        String        @id
  userId    String?       @map("user_id")
  user      User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  adminId   String?       @map("admin_id")
  admin     Admin?        @relation(fields: [adminId], references: [id], onDelete: SetNull)
  status    String        @default("active")
  createdAt DateTime      @default(now()) @map("created_at")
  messages  ChatMessage[]

  @@index([status, createdAt])
  @@index([userId])
  @@index([adminId])
  @@map("chat_rooms")
}

model ChatMessage {
  id         String   @id @default(cuid())
  roomId     String   @map("room_id")
  room       ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  senderId   String   @map("sender_id")
  senderType String   @map("sender_type")
  message    String   @default("")
  attachment Json?
  isRead     Boolean  @default(false) @map("is_read")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([roomId, createdAt])
  @@map("chat_messages")
}

model FounderSubmission {
  id              String   @id
  profileType     String?  @map("profile_type")
  fullName        String?  @map("full_name")
  email           String?
  phone           String?
  linkedin        String?
  companyName     String?  @map("company_name")
  sector          String?
  stage           String?
  capitalRequired String?  @map("capital_required")
  oneLiner        String?  @map("one_liner")
  orgName         String?  @map("org_name")
  ticketSize      String?  @map("ticket_size")
  stagePref       String?  @map("stage_pref")
  geoPref         String?  @map("geo_pref")
  confidence      String?
  message         String?
  confirmAccuracy Boolean  @default(false) @map("confirm_accuracy")
  deckFile        String?  @map("deck_file")
  reviewed        Boolean  @default(false)
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("founder_submissions")
}

model SiteContent {
  id        String   @id @default("main")
  content   Json     @default("{}")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("site_content")
}

model PushToken {
  id        String   @id @default(cuid())
  token     String   @unique
  platform  String?
  userId    String?  @map("user_id")
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  adminId   String?  @map("admin_id")
  admin     Admin?   @relation(fields: [adminId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([adminId])
  @@map("push_tokens")
}

model AuditLog {
  id         String   @id @default(cuid())
  adminId    String?  @map("admin_id")
  admin      Admin?   @relation(fields: [adminId], references: [id], onDelete: SetNull)
  action     String
  resource   String
  resourceId String?  @map("resource_id")
  details    Json?
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([adminId, createdAt])
  @@index([resource, createdAt])
  @@map("audit_logs")
}
